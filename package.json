{
  "name": "prometheus-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc -b",
    "test:e2e": "playwright test",
    "format": "prettier --write src server desktop scripts/*.mjs tests vite.config.ts playwright.config.ts mobile/App.tsx",
    "format:check": "prettier --check src server desktop scripts/*.mjs tests vite.config.ts playwright.config.ts mobile/App.tsx",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "mobile:check": "npm --prefix mobile run check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.mjs",
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
