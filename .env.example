# Copy to .env. Never commit real keys.
PORT=3001
# ollama | openai
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
# Optional OpenAI-compatible provider (pricing and quotas depend on provider)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# Optional self-hosted SearXNG instance, with JSON format enabled
# SEARXNG_URL=http://127.0.0.1:8080

# Optional single-owner session protection. REQUIRED before exposing this server.
# Use a unique, strong passphrase; never commit the actual value.
# PROMETHEUS_PASSWORD=
# PROMETHEUS_DATA_DIR=.prometheus

# Optional local voice engines: installed binaries/models, never auto-downloaded
# STT_PYTHON=/absolute/path/to/python3
# WHISPER_MODEL_PATH=/absolute/path/to/local-whisper-model
# PIPER_PATH=/absolute/path/to/piper
# PIPER_MODEL_PATH=/absolute/path/to/turkish-voice.onnx
